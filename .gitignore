*.pt
*.pth
*.safetensors
checkpoints/
runs/
wandb/

# ---- Plots / generated output ----
# (We'll selectively force-add specific result images later with `git add -f`.)
*.png
*.gif
*.mp4

# ---- Personal study notes (local only, not published) ----
docs/

# ---- OS / editor cruft ----
.DS_Store
.vscode/
.idea/
